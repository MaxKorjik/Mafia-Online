{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Backend (Uvicorn)",
      "type": "shell",
      "command": ".venv\\Scripts\\uvicorn app.main:app --reload",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Frontend (NPM)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/mafia-frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "🚀 Start All (Backend + Frontend)",
      "dependsOn": ["Run Backend (Uvicorn)", "Run Frontend (NPM)"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}